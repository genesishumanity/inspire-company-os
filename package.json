{
  "name": "inspire-company-os",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var AUTH_MODE:local",
    "check": "node --check src/index.js && node --check src/ui.js && node --check src/auth.js && node --check src/entry.js",
    "deploy": "wrangler deploy",
    "smoke": "bash scripts/smoke.sh",
    "db:create": "wrangler d1 create inspire-company-os-db",
    "db:migrate:local": "wrangler d1 migrations apply COMPANY_OS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply COMPANY_OS_DB --remote"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
